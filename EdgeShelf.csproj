<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EdgeShelf</AssemblyName>
    <RootNamespace>EdgeShelf</RootNamespace>
    <ApplicationIcon>Assets\EdgeShelf.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <Resource Include="Assets\EdgeShelf.ico" />
    <Resource Include="Assets\EdgeShelf-logo.png" />
  </ItemGroup>

</Project>
